# ===== الخيار الموصى به: Gemini (نفس مزوّد النسخة السابقة) =====
# مفتاح من Google AI Studio (aistudio.google.com)
GEMINI_API_KEY=
# نماذج النص لكل مستوى. الأسماء بتتغير، راجعها في AI Studio (gemini-2.5-flash مش متاح للحسابات الجديدة)
MODEL_FAST=gemini-3.5-flash-lite
MODEL_BALANCED=gemini-3-flash-preview
MODEL_STRONG=gemini-3-flash-preview
# نماذج الصور (توليد وتعديل)، مفصولة بفاصلة وتُجرَّب بالترتيب. غالبًا مش مجانية، راجع صفحة الأسعار
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-3.1-flash-lite-image
# مزوّدين توليد الصور بالترتيب. pollinations مجاني من غير مفتاح (بيستخدم لما Gemini يفشل، للتوليد بس مش التعديل)
IMAGE_PROVIDERS=gemini,pollinations
# اختياري: توكن مجاني من auth.pollinations.ai بيشيل العلامة المائية ويرفع الحد
POLLINATIONS_TOKEN=
# قراءة الردود بصوت (اختياري، دي القيم الافتراضية). أسماء الأصوات من صفحة Gemini TTS
TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview
TTS_VOICE=Kore

# ===== مزوّدين تانيين (اختياري) =====
ANTHROPIC_API_KEY=
# أي مزوّد متوافق مع واجهة OpenAI (OpenRouter / Groq ...). الأسماء في MODEL_* لازم تطابق المزوّد
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

MAX_TOKENS=1500
# الحد اليومي لكل مستخدم. 0 = بدون حد
DAILY_REQUESTS=20
DAILY_IMAGES=5
DAILY_TTS=60
# غيّر القيمة دي لسلسلة عشوائية طويلة قبل أي نشر
JWT_SECRET=dev-secret-change-me
SIGNUPS_PER_IP_DAY=5
